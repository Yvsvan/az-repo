# Normalizar todos los archivos de texto a LF en el repositorio.
# Esto evita que ruff format --check falle en Windows CI porque
# git convierte LF -> CRLF al hacer checkout con core.autocrlf=true.

* text=auto eol=lf

# Forzar LF explícitamente en los archivos clave
*.py    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Binarios — no tocar los finales de línea
*.ico   binary
*.png   binary
*.jpg   binary
*.zip   binary
*.exe   binary
*.pyz   binary
*.pkg   binary
